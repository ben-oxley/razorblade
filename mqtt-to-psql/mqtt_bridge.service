[Unit]
Description=Standalone UV MQTT to Postgres Bridge
# Wait for network and local mosquitto if applicable
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=your_username
# Set this to the directory where your script lives
WorkingDirectory=/home/your_username/scripts
# Use the full path to the uv binary
ExecStart=/home/your_username/.cargo/bin/uv run mqtt_to_postgres.py

# Restart logic
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
