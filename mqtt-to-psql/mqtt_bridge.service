[Unit]
Description=Standalone UV MQTT to Postgres Bridge
# Wait for network and local mosquitto if applicable
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=blade
# Set this to the directory where your script lives
WorkingDirectory=/home/blade/scripts
# Use the full path to the uv binary
ExecStart=/home/blade/.local/bin/uv run mqtt_to_postgres.py

# Restart logic
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
